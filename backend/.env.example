# PostgreSQL (usate da docker-compose.yml)
POSTGRES_USER=dydat
POSTGRES_PASSWORD=CAMBIA_IN_PRODUZIONE
POSTGRES_DB=dydat

# Database
DATABASE_URL=postgresql+asyncpg://dydat:CAMBIA_IN_PRODUZIONE@db:5432/dydat

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-LA_TUA_CHIAVE_QUI

# LLM Models (configurable, never hardcoded)
LLM_MODEL_TUTOR=claude-sonnet-4-5-20250929
LLM_MODEL_PIPELINE=claude-haiku-4-5-20251001
LLM_MODEL_ESCALATION=claude-sonnet-4-5-20250929

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Auth
JWT_SECRET=GENERA_UN_SECRET_SICURO_QUI
JWT_EXPIRE_HOURS=720

# Timeouts
TIMEOUT_LLM_SEC=60
